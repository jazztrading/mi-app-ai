# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Fase 0 · Seguridad ─────────────────────────────────────────────────────
# Clave de acceso a la API (mínimo 16 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sin ella, la API protegida responde 503 (falla cerrado).
APP_ACCESS_TOKEN=""
# Opcionales (valores por defecto entre paréntesis)
# MAX_BODY_MB=12  MAX_FILE_MB=8  MAX_FILES=5  MAX_TEXT_CHARS=200000
# RL_COSTLY_MAX=15 (análisis/hora/IP)  RL_API_MAX=300  RL_FAILED_AUTH_MAX=20
# TRUST_PROXY=1  DATA_DIR=/ruta/a/disco/persistente

# ── Sin clave de acceso (tu decisión: cualquiera con la URL podrá usar y borrar) ──
# REQUIRE_AUTH=false        # desactiva la clave; por defecto es obligatoria
# DAILY_COSTLY_MAX=60       # tope GLOBAL diario de análisis/auditorías (todas las IP juntas)
# MAX_STORED_ANALYSES=500   # tope de análisis guardados
# Además: fija un tope mensual de gasto en Google AI Studio (Spend → Monthly spend cap).

# ── Verificación de citas (Fase 1) ───────────────────────────────────────────
# Desde febrero de 2026 OpenAlex exige una clave de API gratuita (https://openalex.org/settings/api) y ya ignora "mailto".
# Sin ella solo se usa Crossref: se verifica que la obra existe y coincide, pero habrá menos resúmenes para comprobar el respaldo
# y no se sugieren lecturas relacionadas.
# OPENALEX_API_KEY=
# Correo de contacto REAL: Crossref lo usa para su "polite pool". Si no se define, no se envía (no se inventa uno).
# CONTACT_EMAIL=
